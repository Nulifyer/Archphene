#!/usr/bin/bash
set -euo pipefail

tput clear
printf 'REFLOW-BEGIN-'
for ((chunk = 1; chunk <= 12; chunk++)); do
  printf '%02d-abcdefghij-' "$chunk"
done
printf 'REFLOW-END\r\n'
for ((line = 1; line <= 80; line++)); do
  printf 'REFLOW-FILL-%03d\r\n' "$line"
done
printf 'REFLOW-LIVE-READY'
IFS= read -r -n 1
