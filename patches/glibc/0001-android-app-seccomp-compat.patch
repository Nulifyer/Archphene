+#ifdef ARCHPHENE_ANDROID_APP_COMPAT
+/* Resolver configuration is loaded through an internal libc path which an
+   LD_PRELOAD bridge cannot interpose.  Resolve only the fixed resolver suffix
+   below the validated Android-app runtime root.  The environment is immutable
+   for an Archphene process and Android does not grant Linux file capabilities
+   or set-ID elevation to package files.  */
+static int
+archphene_has_parent_component (const char *path)
+{
+  const char *part = path;
+  while ((part = strstr (part, "..")) != NULL)
+    {
+      int starts_component = part == path || part[-1] == '/';
+      int ends_component = part[2] == '\0' || part[2] == '/';
+      if (starts_component && ends_component)
+        return 1;
+      part += 2;
+    }
+  return 0;
+}
+
+const char *
+__archphene_resolv_conf_path (char output[PATH_MAX])
+{
+  const char *enabled = getenv ("ARCHPHENE_FAKE_CHROOT");
+  const char *root = getenv ("ARCHPHENE_RUNTIME_ROOT");
+  if (enabled == NULL || strcmp (enabled, "1") != 0
+      || root == NULL || root[0] != '/' || root[1] == '\0'
+      || strchr (root, '\n') != NULL
+      || archphene_has_parent_component (root))
+    return _PATH_RESCONF;
+
+  size_t root_length = strlen (root);
+  while (root_length > 1 && root[root_length - 1] == '/')
+    --root_length;
+  if (root_length + sizeof (_PATH_RESCONF) > PATH_MAX)
+    return _PATH_RESCONF;
+  memcpy (output, root, root_length);
+  memcpy (output + root_length, _PATH_RESCONF, sizeof (_PATH_RESCONF));
+  return output;
+}
+#endif
