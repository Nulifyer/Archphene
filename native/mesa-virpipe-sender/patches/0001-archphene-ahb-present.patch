+static bool
+drisw_present_resource(struct dri_drawable *drawable,
+                       uint32_t helper_generation,
+                       uint32_t resource_id,
+                       uint64_t fence_sequence)
+{
+   const __DRIswrastLoaderExtension *loader = drawable->screen->swrast_loader;
+
+   if (loader->base.version < 7 || !loader->presentResource)
+      return false;
+
+   return loader->presentResource(drawable, helper_generation, resource_id,
+                                  fence_sequence, drawable->loaderPrivate);
+}
