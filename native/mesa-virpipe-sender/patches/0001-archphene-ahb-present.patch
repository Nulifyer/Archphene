+uint32_t
+virgl_vtest_send_archphene_resource_create(struct virgl_vtest_winsys *vws,
+                                           enum pipe_texture_target target,
+                                           uint32_t format,
+                                           uint32_t bind,
+                                           uint32_t width,
+                                           uint32_t height,
+                                           uint32_t depth,
+                                           uint32_t array_size,
+                                           uint32_t last_level,
+                                           uint32_t nr_samples)
+{
+   uint32_t request[VCMD_ARCHPHENE_RES_CREATE_AHB_SIZE];
+   uint32_t response[VTEST_HDR_SIZE];
+   uint32_t handle;
+
+   response[VTEST_CMD_LEN] = VCMD_ARCHPHENE_RES_CREATE_AHB_SIZE;
+   response[VTEST_CMD_ID] = VCMD_ARCHPHENE_RESOURCE_CREATE_AHB;
+   request[VCMD_RES_CREATE_RES_HANDLE] = 0;
+   request[VCMD_RES_CREATE_TARGET] = target;
+   request[VCMD_RES_CREATE_FORMAT] = format;
+   request[VCMD_RES_CREATE_BIND] = bind;
+   request[VCMD_RES_CREATE_WIDTH] = width;
+   request[VCMD_RES_CREATE_HEIGHT] = height;
+   request[VCMD_RES_CREATE_DEPTH] = depth;
+   request[VCMD_RES_CREATE_ARRAY_SIZE] = array_size;
+   request[VCMD_RES_CREATE_LAST_LEVEL] = last_level;
+   request[VCMD_RES_CREATE_NR_SAMPLES] = nr_samples;
+
+   virgl_block_write(vws->sock_fd, response, sizeof(response));
+   virgl_block_write(vws->sock_fd, request, sizeof(request));
+   virgl_block_read(vws->sock_fd, response, sizeof(response));
+   if (response[VTEST_CMD_LEN] != VCMD_ARCHPHENE_RES_CREATE_AHB_RESP_SIZE ||
+       response[VTEST_CMD_ID] != VCMD_ARCHPHENE_RESOURCE_CREATE_AHB)
+      return 0;
+   virgl_block_read(vws->sock_fd, &handle, sizeof(handle));
+   return handle;
+}
+
+uint64_t
+virgl_vtest_send_archphene_present(struct virgl_vtest_winsys *vws,
+                                   uint32_t handle)
+{
+   uint32_t header[VTEST_HDR_SIZE] = {
+      [VTEST_CMD_LEN] = VCMD_ARCHPHENE_PRESENT_AHB_SIZE,
+      [VTEST_CMD_ID] = VCMD_ARCHPHENE_PRESENT_AHB,
+   };
+   uint32_t response[VCMD_ARCHPHENE_PRESENT_AHB_RESP_SIZE];
