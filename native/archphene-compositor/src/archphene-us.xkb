        key <RCTL> { [ Control_R ] };
        key <RALT> { [ Alt_R ] };
        key <HOME> { [ Home ] };
        key <UP> { [ Up ] };
        key <PGUP> { [ Prior ] };
        key <LEFT> { [ Left ] };
