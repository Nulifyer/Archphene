        key <AC10> { type = "TWO_LEVEL", [ semicolon, colon ] };
        key <AC11> { type = "TWO_LEVEL", [ apostrophe, quotedbl ] };
        key <LFSH> { [ Shift_L ] };
        key <BKSL> { type = "TWO_LEVEL", [ backslash, bar ] };
        key <AB01> { type = "TWO_LEVEL", [ z, Z ] };
        key <AB02> { type = "TWO_LEVEL", [ x, X ] };
        key <AB03> { type = "TWO_LEVEL", [ c, C ] };
        key <AB04> { type = "TWO_LEVEL", [ v, V ] };
        key <AB05> { type = "TWO_LEVEL", [ b, B ] };
        key <AB06> { type = "TWO_LEVEL", [ n, N ] };
        key <AB07> { type = "TWO_LEVEL", [ m, M ] };
        key <AB08> { type = "TWO_LEVEL", [ comma, less ] };
        key <AB09> { type = "TWO_LEVEL", [ period, greater ] };
        key <AB10> { type = "TWO_LEVEL", [ slash, question ] };
        key <RTSH> { [ Shift_R ] };
        key <LALT> { [ Alt_L ] };
        key <SPCE> { [ space ] };
        key <CAPS> { [ Caps_Lock ] };
        key <FK01> { [ F1 ] };
