+static void vtest_server_open_archphene_present_socket(void)
+{
+   struct sockaddr_un un;
+   uint8_t frame[64] = {0};
+   size_t written = 0;
+
+   if (!server.archphene_present_socket_name)
+      return;
+
+   server.archphene_present_socket = socket(PF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+   if (server.archphene_present_socket < 0)
+      goto err;
+
+   memset(&un, 0, sizeof(un));
+   un.sun_family = AF_UNIX;
+   memcpy(un.sun_path, server.archphene_present_socket_name,
+          strlen(server.archphene_present_socket_name) + 1);
+   if (connect(server.archphene_present_socket, (struct sockaddr *)&un,
+               offsetof(struct sockaddr_un, sun_path) + strlen(un.sun_path) + 1) < 0)
+      goto err;
+
+   memcpy(frame, "APHB", 4);
+   archphene_put_u16(frame, 4, 1);
+   archphene_put_u16(frame, 6, 1);
+   archphene_put_u32(frame, 8, server.archphene_session_id);
+   archphene_put_u32(frame, 12, server.archphene_helper_generation);
+   memcpy(frame + 16, server.archphene_present_token, 16);
+   while (written < sizeof(frame)) {
+      ssize_t result = write(server.archphene_present_socket, frame + written,
+                             sizeof(frame) - written);
+      if (result > 0) {
+         written += (size_t)result;
+         continue;
+      }
+      if (result < 0 && errno == EINTR)
+         continue;
+      goto err;
+   }
+   return;
+
+err:
+   perror("Failed to open Archphene present channel");
+   vtest_server_close_archphene_present_socket();
+   exit(EXIT_FAILURE);
+}
+
+static void vtest_server_close_archphene_present_socket(void)
+{
+   if (server.archphene_present_socket != -1) {
+      close(server.archphene_present_socket);
+      server.archphene_present_socket = -1;
+   }
+}
