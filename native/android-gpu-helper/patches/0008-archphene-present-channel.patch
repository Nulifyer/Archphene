+static bool archphene_parse_u32(const char *value, uint32_t *result)
+{
+   char *end = NULL;
+   unsigned long parsed;
+
+   if (!value || !value[0])
+      return false;
+   errno = 0;
+   parsed = strtoul(value, &end, 10);
+   if (errno || !end || *end || !parsed || parsed > UINT32_MAX)
+      return false;
+   *result = (uint32_t)parsed;
+   return true;
+}
+
+static int archphene_hex_nibble(char value)
+{
+   if (value >= '0' && value <= '9')
+      return value - '0';
+   if (value >= 'a' && value <= 'f')
+      return value - 'a' + 10;
+   return -1;
+}
+
+static bool archphene_parse_token(const char *value, uint8_t token[16])
+{
+   unsigned nonzero = 0;
+   size_t i;
+
+   if (!value || strlen(value) != 32)
+      return false;
+   for (i = 0; i < 16; i++) {
+      int high = archphene_hex_nibble(value[i * 2]);
+      int low = archphene_hex_nibble(value[i * 2 + 1]);
+      if (high < 0 || low < 0)
+         return false;
+      token[i] = (uint8_t)((high << 4) | low);
+      nonzero |= token[i];
+   }
+   return nonzero != 0;
+}
+
+static void archphene_put_u16(uint8_t *frame, size_t offset, uint16_t value)
+{
+   frame[offset] = (uint8_t)value;
+   frame[offset + 1] = (uint8_t)(value >> 8);
+}
+
+static void archphene_put_u32(uint8_t *frame, size_t offset, uint32_t value)
+{
+   frame[offset] = (uint8_t)value;
+   frame[offset + 1] = (uint8_t)(value >> 8);
+   frame[offset + 2] = (uint8_t)(value >> 16);
+   frame[offset + 3] = (uint8_t)(value >> 24);
+}
 
