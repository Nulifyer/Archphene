+int vtest_archphene_wait_release_ahb(uint32_t length_dw)
+{
+#ifdef __ANDROID__
+   struct vtest_context *ctx = vtest_get_current_context();
+   struct vtest_resource *res;
+   uint32_t request[VCMD_ARCHPHENE_WAIT_RELEASE_AHB_SIZE];
+   uint32_t response[VTEST_HDR_SIZE] = {
+      [VTEST_CMD_LEN] = 0,
+      [VTEST_CMD_ID] = VCMD_ARCHPHENE_WAIT_RELEASE_AHB,
+   };
+   uint64_t sequence;
+   int fence_fd = -1;
+   int ret;
+
+   if (length_dw != VCMD_ARCHPHENE_WAIT_RELEASE_AHB_SIZE)
+      return -EINVAL;
+   ret = ctx->input->read(ctx->input, request, sizeof(request));
+   if (ret != sizeof(request))
+      return -EIO;
+   sequence = (uint64_t)request[VCMD_ARCHPHENE_WAIT_RELEASE_AHB_SEQUENCE_LO] |
+              ((uint64_t)request[VCMD_ARCHPHENE_WAIT_RELEASE_AHB_SEQUENCE_HI] << 32);
+   res = util_hash_table_get(
+      ctx->resource_table,
+      intptr_to_pointer(request[VCMD_ARCHPHENE_WAIT_RELEASE_AHB_RES_HANDLE]));
+   if (!res || !res->archphene_registered || !res->archphene_present_outstanding ||
+       !sequence || sequence != res->archphene_last_present_sequence)
+      return -EINVAL;
+
+   ret = vtest_server_receive_archphene_release(res->res_id, sequence, &fence_fd);
+   if (ret)
+      return ret;
+   if (fence_fd >= 0) {
+      ret = sync_wait(fence_fd, -1);
+      close(fence_fd);
+      if (ret)
+         return -errno;
+   }
+   res->archphene_present_outstanding = false;
+   response[VTEST_CMD_LEN] = 0;
+   response[VTEST_CMD_ID] = VCMD_ARCHPHENE_WAIT_RELEASE_AHB;
+   ret = vtest_block_write(ctx->out_fd, response, sizeof(response));
+   return ret < 0 ? ret : 0;
+#else
+   (void)length_dw;
+   return -ENOTSUP;
+#endif
+}
