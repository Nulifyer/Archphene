diff --git a/vtest/vtest_server.c b/vtest/vtest_server.c
index 5483114..cfd00d8 100644
--- a/vtest/vtest_server.c
+++ b/vtest/vtest_server.c
@@ -360,6 +360,91 @@ int vtest_server_send_archphene_drop(uint32_t resource_id)
    return archphene_send_all(frame, sizeof(frame));
 }
 
+static int archphene_receive_all(void *data, size_t size)
+{
+   uint8_t *bytes = data;
+   size_t received = 0;
+   int error;
+
+   while (received < size) {
+      ssize_t result = recv(server.archphene_present_socket, bytes + received,
+                            size - received, 0);
+      if (result > 0) {
+         received += (size_t)result;
+         continue;
+      }
+      if (result < 0 && errno == EINTR)
+         continue;
+      error = result < 0 ? -errno : -EPIPE;
+      vtest_server_close_archphene_present_socket();
+      return error;
+   }
+   return 0;
+}
+
+int vtest_server_receive_archphene_release(uint32_t resource_id,
+                                           uint64_t fence_sequence,
+                                           int *fence_fd)
+{
+   uint8_t frame[64];
+   uint8_t marker = 0;
+   uint8_t control[CMSG_SPACE(sizeof(int) * 4)] = { 0 };
+   struct iovec iov = { .iov_base = &marker, .iov_len = 1 };
+   struct msghdr message = { 0 };
+   struct cmsghdr *header;
+   uint8_t expected[64];
+   int descriptor = -1;
+   size_t descriptor_count = 0;
+   int result;
+
+   if (!fence_fd || !resource_id || !fence_sequence)
+      return -EINVAL;
+   *fence_fd = -1;
+   result = archphene_receive_all(frame, sizeof(frame));
+   if (result)
+      return result;
+   archphene_init_frame(expected, 4);
+   archphene_put_u32(expected, 32, resource_id);
+   archphene_put_u64(expected, 48, fence_sequence);
+   if (memcmp(frame, expected, sizeof(frame)))
+      goto invalid;
+
+   message.msg_iov = &iov;
+   message.msg_iovlen = 1;
+   message.msg_control = control;
+   message.msg_controllen = sizeof(control);
+   do {
+      result = recvmsg(server.archphene_present_socket, &message, MSG_CMSG_CLOEXEC);
+   } while (result < 0 && errno == EINTR);
+   header = CMSG_FIRSTHDR(&message);
+   if (header) {
+      if (header->cmsg_level != SOL_SOCKET || header->cmsg_type != SCM_RIGHTS ||
+          header->cmsg_len < CMSG_LEN(0) || header->cmsg_len > message.msg_controllen ||
+          (header->cmsg_len - CMSG_LEN(0)) % sizeof(int))
+         goto invalid;
+      descriptor_count = (header->cmsg_len - CMSG_LEN(0)) / sizeof(int);
+      for (size_t i = 0; i < descriptor_count; i++) {
+         int received;
+         memcpy(&received, (uint8_t *)CMSG_DATA(header) + i * sizeof(int), sizeof(received));
+         if (i == 0)
+            descriptor = received;
+         else if (received >= 0)
+            close(received);
+      }
+   }
+   if (result != 1 || marker != 0x52 || (message.msg_flags & (MSG_CTRUNC | MSG_TRUNC)) ||
+       (header && (descriptor_count != 1 || descriptor < 0)))
+      goto invalid;
+   *fence_fd = descriptor;
+   return 0;
+
+invalid:
+   if (descriptor >= 0)
+      close(descriptor);
+   vtest_server_close_archphene_present_socket();
+   return -EPROTO;
+}
