diff --git a/vtest/vtest_server.c b/vtest/vtest_server.c
index cb84267..b60576a 100644
--- a/vtest/vtest_server.c
+++ b/vtest/vtest_server.c
@@ -41,6 +41,9 @@
 #include <fcntl.h>
 #include <getopt.h>
 #include <string.h>
+#ifdef __ANDROID__
+#include <android/hardware_buffer.h>
+#endif
 
 #include "util.h"
 #include "util/list.h"
@@ -249,6 +252,114 @@ static void archphene_put_u32(uint8_t *frame, size_t offset, uint32_t value)
    frame[offset + 3] = (uint8_t)(value >> 24);
 }
 
+static void archphene_put_u64(uint8_t *frame, size_t offset, uint64_t value)
+{
+   archphene_put_u32(frame, offset, (uint32_t)value);
+   archphene_put_u32(frame, offset + 4, (uint32_t)(value >> 32));
+}
+
+static int archphene_send_all(const void *data, size_t size)
+{
+   const uint8_t *bytes = data;
+   size_t written = 0;
+   int error;
+
+   while (written < size) {
+      ssize_t result = send(server.archphene_present_socket, bytes + written,
+                            size - written, MSG_NOSIGNAL);
+      if (result > 0) {
+         written += (size_t)result;
+         continue;
+      }
+      if (result < 0 && errno == EINTR)
+         continue;
+      error = result < 0 ? -errno : -EPIPE;
+      vtest_server_close_archphene_present_socket();
+      return error;
+   }
+   return 0;
+}
+
+static void archphene_init_frame(uint8_t frame[64], uint16_t opcode)
+{
+   memset(frame, 0, 64);
+   memcpy(frame, "APHB", 4);
+   archphene_put_u16(frame, 4, 1);
+   archphene_put_u16(frame, 6, opcode);
+   archphene_put_u32(frame, 8, server.archphene_session_id);
+   archphene_put_u32(frame, 12, server.archphene_helper_generation);
+   memcpy(frame + 16, server.archphene_present_token, 16);
+}
+
+bool vtest_server_archphene_present_enabled(void)
+{
+   return server.archphene_present_socket >= 0;
+}
+
+int vtest_server_send_archphene_resource(uint32_t resource_id, uint16_t slot,
+                                         uint32_t width, uint32_t height,
+                                         uint64_t estimated_bytes, void *buffer)
+{
+#ifdef __ANDROID__
+   uint8_t frame[64];
+   int result;
+
+   if (!resource_id || slot >= 3 || !width || !height || !estimated_bytes || !buffer)
+      return -EINVAL;
+   archphene_init_frame(frame, 2);
+   archphene_put_u32(frame, 32, resource_id);
+   archphene_put_u16(frame, 36, slot);
+   archphene_put_u32(frame, 40, width);
+   archphene_put_u32(frame, 44, height);
+   archphene_put_u64(frame, 48, estimated_bytes);
+   result = archphene_send_all(frame, sizeof(frame));
+   if (result)
+      return result;
+   result = AHardwareBuffer_sendHandleToUnixSocket(buffer,
+                                                    server.archphene_present_socket);
+   if (result) {
+      vtest_server_close_archphene_present_socket();
+      return result < 0 ? result : -result;
+   }
+   return 0;
+#else
+   (void)resource_id;
+   (void)slot;
+   (void)width;
+   (void)height;
+   (void)estimated_bytes;
+   (void)buffer;
+   return -ENOTSUP;
+#endif
+}
+
+int vtest_server_send_archphene_present(uint32_t resource_id,
+                                        uint64_t fence_sequence)
+{
+   uint8_t frame[64];
+   const uint8_t marker = 0x46;
+   int result;
+
+   if (!resource_id || !fence_sequence)
+      return -EINVAL;
+   archphene_init_frame(frame, 3);
+   archphene_put_u32(frame, 32, resource_id);
+   archphene_put_u64(frame, 48, fence_sequence);
+   result = archphene_send_all(frame, sizeof(frame));
+   return result ? result : archphene_send_all(&marker, sizeof(marker));
+}
+
+int vtest_server_send_archphene_drop(uint32_t resource_id)
+{
+   uint8_t frame[64];
+
+   if (!resource_id)
+      return -EINVAL;
+   archphene_init_frame(frame, 5);
+   archphene_put_u32(frame, 32, resource_id);
+   return archphene_send_all(frame, sizeof(frame));
+}
