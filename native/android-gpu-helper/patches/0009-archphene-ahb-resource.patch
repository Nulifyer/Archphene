+int vtest_archphene_resource_create_ahb(uint32_t length_dw)
+{
+#ifdef __ANDROID__
+   static const EGLint image_attributes[] = { EGL_IMAGE_PRESERVED_KHR, EGL_TRUE,
+                                              EGL_NONE };
+   struct virgl_renderer_resource_create_args args;
+   AHardwareBuffer_Desc requested = { 0 };
+   AHardwareBuffer_Desc actual = { 0 };
+   struct vtest_context *ctx = vtest_get_current_context();
+   struct vtest_resource *res = NULL;
+   EGLClientBuffer client_buffer;
+   EGLDisplay display;
+   EGLImageKHR image = EGL_NO_IMAGE_KHR;
+   AHardwareBuffer *buffer = NULL;
+   uint32_t response[VTEST_HDR_SIZE + VCMD_ARCHPHENE_RES_CREATE_AHB_RESP_SIZE];
+   uint8_t slot;
+   int ret;
+
+   if (length_dw != VCMD_ARCHPHENE_RES_CREATE_AHB_SIZE ||
+       !vtest_server_archphene_present_enabled())
+      return -EINVAL;
+   memset(&args, 0, sizeof(args));
+   ret = vtest_create_resource_decode_args(ctx, &args);
+   if (ret)
+      return ret;
+   if (args.handle || args.target != PIPE_TEXTURE_2D ||
+       args.format != VIRGL_FORMAT_R8G8B8A8_UNORM ||
+       !(args.bind & VIRGL_BIND_RENDER_TARGET) ||
+       args.width == 0 || args.width > 8192 ||
+       args.height == 0 || args.height > 8192 ||
+       (uint64_t)args.width * args.height > 33554432 ||
+       args.depth != 1 || args.array_size != 1 || args.last_level != 0 ||
+       args.nr_samples != 0)
+      return -EINVAL;
+   for (slot = 0; slot < 3; slot++) {
+      if (!(archphene_live_slots & (1u << slot)))
+         break;
+   }
+   if (slot == 3)
+      return -ENOSPC;
+
+   requested.width = args.width;
+   requested.height = args.height;
+   requested.layers = 1;
+   requested.format = AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM;
+   requested.usage = AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE |
+                     AHARDWAREBUFFER_USAGE_GPU_COLOR_OUTPUT;
+   if (!AHardwareBuffer_isSupported(&requested))
+      return -ENOTSUP;
+   ret = AHardwareBuffer_allocate(&requested, &buffer);
+   if (ret || !buffer)
+      return ret ? (ret < 0 ? ret : -ret) : -ENOMEM;
+
+   display = eglGetCurrentDisplay();
+   client_buffer = eglGetNativeClientBufferANDROID(buffer);
+   if (display == EGL_NO_DISPLAY || !client_buffer)
+      goto fail;
+   image = eglCreateImageKHR(display, EGL_NO_CONTEXT,
+                             EGL_NATIVE_BUFFER_ANDROID, client_buffer,
+                             image_attributes);
+   if (image == EGL_NO_IMAGE_KHR)
+      goto fail;
+
+   res = vtest_new_resource(0);
+   if (!res)
+      goto fail;
+   args.handle = res->res_id;
+   ret = virgl_renderer_resource_import_eglimage(&args, image);
+   if (ret)
+      goto fail;
+   virgl_renderer_ctx_attach_resource(ctx->ctx_id, res->res_id);
+   res->archphene_buffer = buffer;
+   res->archphene_image = image;
+   res->archphene_slot = slot;
+   archphene_live_slots |= (uint8_t)(1u << slot);
+   AHardwareBuffer_describe(buffer, &actual);
+   ret = vtest_server_send_archphene_resource(
+      res->res_id, slot, actual.width, actual.height,
+      (uint64_t)actual.stride * actual.height * 4, buffer);
+   if (ret)
+      goto fail_imported;
+   res->archphene_registered = true;
+
+   response[VTEST_CMD_LEN] = VCMD_ARCHPHENE_RES_CREATE_AHB_RESP_SIZE;
+   response[VTEST_CMD_ID] = VCMD_ARCHPHENE_RESOURCE_CREATE_AHB;
+   response[VTEST_CMD_DATA_START] = res->res_id;
+   ret = vtest_block_write(ctx->out_fd, response, sizeof(response));
+   if (ret < 0)
+      goto fail_imported;
+   util_hash_table_set(ctx->resource_table, intptr_to_pointer(res->res_id), res);
+   return 0;
+
+fail_imported:
+   vtest_unref_resource(res);
+   return ret;
+fail:
+   if (res)
+      list_add(&res->head, &renderer.free_resources);
+   if (image != EGL_NO_IMAGE_KHR)
+      eglDestroyImageKHR(display, image);
+   if (buffer)
+      AHardwareBuffer_release(buffer);
+   return -EINVAL;
+#else
+   (void)length_dw;
+   return -ENOTSUP;
+#endif
+}
+
+int vtest_archphene_present_ahb(uint32_t length_dw)
+{
+#ifdef __ANDROID__
+   struct vtest_context *ctx = vtest_get_current_context();
+   struct vtest_resource *res;
+   uint32_t request[VCMD_ARCHPHENE_PRESENT_AHB_SIZE];
+   uint32_t response[VTEST_HDR_SIZE + VCMD_ARCHPHENE_PRESENT_AHB_RESP_SIZE];
+   uint64_t sequence;
+   int ret;
+
+   if (length_dw != VCMD_ARCHPHENE_PRESENT_AHB_SIZE)
+      return -EINVAL;
+   ret = ctx->input->read(ctx->input, request, sizeof(request));
+   if (ret != sizeof(request))
+      return -EIO;
+   res = util_hash_table_get(ctx->resource_table,
+                             intptr_to_pointer(request[VCMD_ARCHPHENE_PRESENT_AHB_RES_HANDLE]));
+   if (!res || !res->archphene_registered || res->archphene_present_outstanding)
+      return -EINVAL;
+
+   glFinish();
+   sequence = ++archphene_fence_sequence;
+   if (!sequence)
+      sequence = ++archphene_fence_sequence;
+   ret = vtest_server_send_archphene_present(res->res_id, sequence);
+   if (ret)
+      return ret;
+   res->archphene_present_outstanding = true;
+   response[VTEST_CMD_LEN] = VCMD_ARCHPHENE_PRESENT_AHB_RESP_SIZE;
+   response[VTEST_CMD_ID] = VCMD_ARCHPHENE_PRESENT_AHB;
+   response[VTEST_CMD_DATA_START] = (uint32_t)sequence;
+   response[VTEST_CMD_DATA_START + 1] = (uint32_t)(sequence >> 32);
+   ret = vtest_block_write(ctx->out_fd, response, sizeof(response));
+   return ret < 0 ? ret : 0;
+#else
+   (void)length_dw;
+   return -ENOTSUP;
+#endif
+}
